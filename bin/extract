#!/usr/bin/env perl
use v5.44;
use warnings;

use FindBin qw($RealBin);
use lib "$RealBin/../lib";
use tubular::Config ();
use tubular::Extract ();
use JSON::PP ();

sub usage {
    return <<'USAGE';
tubular extract - read numbers or text from txt/csv/pdf files

Usage:
  bin/extract FILE [options]

Options:
  --numbers        emit one value per line (default)
  --text           emit extracted text
  --pages RANGE    PDF only: pages to read, e.g. 1-3,5
  --column C       CSV only: header name or 0-based column index
  --strict 0|1     fail on malformed input (default from config)
  --csv-header A   header policy: auto|always|never (default from config)
  --json           emit machine-readable JSON
  -h, --help       show this help and exit

Examples:
  bin/extract data.csv
  bin/extract report.pdf --pages 1-3 --numbers
  bin/extract values.txt --strict 0
USAGE
}

sub usage_bad {
    my $msg = shift;
    warn "bin/extract: $msg\n\n";
    warn usage();
    exit 2;
}

my %opt = (help => 0, json => 0, mode => 'numbers');
my @files;
my $i = 0;
while ($i < @ARGV) {
    my $arg = $ARGV[$i++];
    if ($arg eq '-h' || $arg eq '--help') { $opt{help} = 1 }
    elsif ($arg eq '--json') { $opt{json} = 1 }
    elsif ($arg eq '--numbers' || $arg eq '-numbers') { $opt{mode} = 'numbers' }
    elsif ($arg eq '--text' || $arg eq '-text') { $opt{mode} = 'text' }
    elsif ($arg eq '--pages') {
        defined $ARGV[$i] or usage_bad("--pages needs a value");
        $opt{pages} = $ARGV[$i++];
    }
    elsif ($arg eq '--column') {
        defined $ARGV[$i] or usage_bad("--column needs a value");
        $opt{column} = $ARGV[$i++];
    }
    elsif ($arg eq '--strict') {
        defined $ARGV[$i] or usage_bad("--strict needs a value");
        my $v = $ARGV[$i++];
        usage_bad("--strict must be 0 or 1") unless $v =~ /^[01]$/;
        $opt{strict} = $v ? 1 : 0;
    }
    elsif ($arg eq '--csv-header') {
        defined $ARGV[$i] or usage_bad("--csv-header needs a value");
        my $v = $ARGV[$i++];
        usage_bad("--csv-header must be auto, always or never") unless $v =~ /^(?:auto|always|never)$/;
        $opt{csv_header} = $v;
    }
    elsif ($arg =~ /^-/) { usage_bad("unknown option '$arg'") }
    else { push @files, $arg }
}

if ($opt{help}) {
    print usage();
    exit 0;
}

usage_bad("exactly one FILE is required") unless @files == 1;

my $config = tubular::Config->new();
my $cfg = $config->as_hash();

$opt{strict} = $cfg->{input}{strict} unless defined $opt{strict};
$opt{csv_header} = $cfg->{input}{csv_header} unless defined $opt{csv_header};

my $res = tubular::Extract->extract($files[0], %opt);

if ($opt{json}) {
    print JSON::PP->new->utf8->canonical->pretty->encode($res);
    exit($res->{ok} ? 0 : 1);
}

if (!$res->{ok}) {
    warn "bin/extract: $res->{error}\n";
    exit 1;
}

if (@{ $res->{warnings} }) {
    warn "bin/extract: warning: $_\n" for @{ $res->{warnings} };
}

if ($opt{mode} eq 'numbers') {
    for my $v (@{ $res->{values} }) {
        print "$v\n";
    }
}
else {
    print $res->{text} // '';
}
exit 0;
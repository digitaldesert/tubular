#!/usr/bin/env perl
use v5.44;
use warnings;

use FindBin qw($RealBin);
use lib "$RealBin/../lib";
use tubular::Config ();
use tubular::Image ();
use tubular::Adapter::Horde ();
use JSON::PP ();
use File::Basename qw(fileparse);
use Time::Piece ();

sub usage {
    return <<'USAGE';
tubular image - generate images through OmniRoute or native AI Horde

Usage:
  bin/image --model MODEL --prompt "PROMPT" [options]
  echo "PROMPT" | bin/image --model MODEL [options]

Options:
  --model MODEL       image model (required). aihorde/* and horde/* go to the
                      native AI Horde API; other models use OmniRoute's
                      provider/model form
  --prompt TEXT       prompt text (required unless a prompt is piped via STDIN)
  --output FILE       output file; default image-YYYYMMDD-HHMMSS.png
  --size SIZE         image size, e.g. 1024x1024 or 'auto'
  --width N           size as width x height (use either --size or
  --height N          --width/--height, not both)
  --n N               number of images to generate (default 1)
  --format EXT        output format/extension: png | jpg | jpeg | webp
  --quality Q         quality: low | medium | high
  --negative-prompt T negative prompt (Horde: appended after ###)
  --seed N            deterministic seed (backends that support it)
  --nsfw              classify an aihorde request as NSFW (skips workers
                      that censor; implies --no-censor-nsfw)
  --no-nsfw           classify an aihorde request as SFW (default)
  --censor-nsfw       if SFW, ask Horde workers to replace accidental NSFW
                      output with a placeholder (default for aihorde)
  --no-censor-nsfw    do not ask Horde workers to censor NSFW output
  --timeout N         request timeout in seconds (default from config, 300 =
                      300000 ms effective)
  --base-url URL      OmniRoute base URL (non-horde models; default from
                      config image.base_url)
  --horde-base-url U  AI Horde API base (aihorde/* models; default from
                      config image.horde_base_url)
  --force             overwrite existing output files
  --json              emit machine-readable JSON
  -h, --help          show this help and exit

Prompt precedence: --prompt wins; otherwise STDIN is read when piped.
Multiple images are written as NAME-001.png, NAME-002.png, ...

Non-horde models use the OmniRoute API and require OMNIROUTE_API_KEY.
aihorde/* and horde/* models call AI Horde directly. Set AI_HORDE_API_KEY
for queue priority (kudos); otherwise the documented anonymous key is used.
The API key is never printed.

aihorde requests are classified as SFW by default (nsfw=false, censor_nsfw=true
are sent explicitly). That is request metadata, not a statement about the
model. A worker that then censors the image fails the run with: "AI Horde
worker censored the generated image because this request was classified as
SFW." Use --nsfw to classify the request as NSFW, or --no-censor-nsfw to keep
SFW classification without asking workers to replace the image.

aihorde jobs run in a queue and can take minutes. wait_time and queue_position
are printed after success and included in --json output. If no worker picks
the job up, that is a queue wait, not a bug in your prompt.

Examples:
  bin/image --model MODEL --prompt "A watercolor painting of Ottawa in autumn"
  bin/image --model MODEL --prompt "A cinematic moonlit forest" \
      --size 1024x1024 --output forest.png
USAGE
}

sub usage_bad {
    my $msg = shift;
    warn "bin/image: $msg\n\n";
    warn usage();
    exit 2;
}

sub decode_utf8_arg ($s) {
    return $s if !defined $s;
    utf8::decode($s) unless utf8::is_utf8($s);
    return $s;
}

my %opt = (help => 0, json => 0, force => 0);

sub is_horde_model ($model) {
    return tubular::Adapter::Horde::is_horde_model($model);
}

my $i = 0;
while ($i < @ARGV) {
    my $arg = $ARGV[$i++];
    if ($arg eq '-h' || $arg eq '--help') { $opt{help} = 1 }
    elsif ($arg eq '--json') { $opt{json} = 1 }
    elsif ($arg eq '--force') { $opt{force} = 1 }
    elsif ($arg eq '--nsfw') { $opt{nsfw} = 1 }
    elsif ($arg eq '--no-nsfw') { $opt{nsfw} = 0 }
    elsif ($arg eq '--censor-nsfw') { $opt{'censor-nsfw'} = 1 }
    elsif ($arg eq '--no-censor-nsfw') { $opt{'censor-nsfw'} = 0 }
    elsif (grep { $arg eq $_ } qw(--model --prompt --output --size --format --quality --negative-prompt --base-url --horde-base-url)) {
        defined $ARGV[$i] or usage_bad("$arg needs a value");
        my $key = $arg =~ s/^--//r;
        $opt{$key} = $ARGV[$i++];
        $opt{$key} = decode_utf8_arg($opt{$key})
            if $key eq 'prompt' || $key eq 'negative-prompt';
    }
    elsif ($arg eq '--width' || $arg eq '--height' || $arg eq '--n'
        || $arg eq '--seed' || $arg eq '--timeout') {
        defined $ARGV[$i] or usage_bad("$arg needs a value");
        my $v = $ARGV[$i++];
        usage_bad("$arg must be an integer") unless $v =~ /^-?\d+$/;
        $opt{$arg =~ s/^--//r} = $v;
    }
    elsif ($arg =~ /^-/) { usage_bad("unknown option '$arg'") }
    else { usage_bad("unexpected argument '$arg'") }
}

if ($opt{help}) {
    print usage();
    exit 0;
}

usage_bad("--model is required") unless defined $opt{model} && length $opt{model};
usage_bad("--model must be a plain string") if ref $opt{model};
if ((exists $opt{nsfw} || exists $opt{'censor-nsfw'}) && !is_horde_model($opt{model})) {
    usage_bad("--nsfw and --censor-nsfw are only valid for aihorde/* (or horde/*) models");
}
if (defined $opt{'horde-base-url'} && !is_horde_model($opt{model})) {
    usage_bad("--horde-base-url is only valid for aihorde/* (or horde/*) models");
}
if (is_horde_model($opt{model}) && defined $opt{'base-url'}) {
    usage_bad("--base-url is for OmniRoute models; for aihorde/* use --horde-base-url");
}

if (defined $opt{size} && (defined $opt{width} || defined $opt{height})) {
    usage_bad("give --size or --width/--height, not both");
}
usage_bad("--width and --height must be given together")
    if (defined $opt{width}) != (defined $opt{height});

my $size;
if (defined $opt{size}) {
    if ($opt{size} ne 'auto' && $opt{size} !~ /^\d+x\d+$/) {
        usage_bad("--size must be like 1024x1024 or 'auto'");
    }
    $size = $opt{size};
}
elsif (defined $opt{width}) {
    for my $k (qw(width height)) {
        if ($opt{$k} < 1 || $opt{$k} > 8192) {
            usage_bad("--$k must be between 1 and 8192");
        }
    }
    $size = $opt{width} . 'x' . $opt{height};
}

if (defined $opt{n} && $opt{n} < 1) {
    usage_bad("--n must be >= 1");
}
if (defined $opt{seed} && $opt{seed} !~ /^-?\d+$/) {
    usage_bad("--seed must be an integer");
}
if (defined $opt{quality}) {
    usage_bad("--quality must be low, medium or high")
        unless grep { $_ eq $opt{quality} } qw(low medium high);
}
if (defined $opt{format}) {
    usage_bad("--format must be png, jpg, jpeg or webp")
        unless grep { $_ eq $opt{format} } qw(png jpg jpeg webp);
}
if (defined $opt{timeout}) {
    usage_bad("--timeout must be a positive integer number of seconds")
        unless $opt{timeout} =~ /^\d+$/ && $opt{timeout} >= 1;
}

my $prompt;
if (defined $opt{prompt}) {
    $prompt = $opt{prompt};
    usage_bad("--prompt must not be empty") if $prompt eq '';
}
elsif (!-t STDIN) {
    binmode STDIN, ':raw:encoding(UTF-8)';
    local $/;
    my $from_stdin = <STDIN> // '';
    $prompt = $from_stdin if length $from_stdin;
}
if (!defined $prompt) {
    usage_bad("a prompt is required (use --prompt or pipe it via STDIN)");
}

my $config = tubular::Config->new();
my $cfg = $config->as_hash();

my $base_url = defined $opt{'base-url'} ? $opt{'base-url'} : $cfg->{image}{base_url};
my $horde_base_url = defined $opt{'horde-base-url'}
    ? $opt{'horde-base-url'} : $cfg->{image}{horde_base_url};
if (is_horde_model($opt{model})) {
    if (!defined $horde_base_url || $horde_base_url !~ m{\Ahttps?://}i) {
        usage_bad("invalid Horde base URL '$horde_base_url' (must start with http:// or https://)");
    }
}
elsif ($base_url !~ m{\Ahttps?://}i) {
    usage_bad("invalid base URL '$base_url' (must start with http:// or https://)");
}

my $timeout = defined $opt{timeout} ? $opt{timeout} : $cfg->{image}{timeout};
if (!$timeout || $timeout =~ /\D/) {
    warn "bin/image: config image.timeout is not a valid number of seconds\n";
    exit 1;
}

my $request = {
    model  => $opt{model},
    prompt => $prompt,
};
$request->{size} = $size if defined $size;
$request->{n} = $opt{n} if defined $opt{n} && $opt{n} >= 1;
$request->{quality} = $opt{quality} if defined $opt{quality};
$request->{seed} = $opt{seed} if defined $opt{seed};
$request->{negative_prompt} = $opt{'negative-prompt'} if defined $opt{'negative-prompt'};
if (is_horde_model($opt{model})) {
    my $nsfw = $opt{nsfw} ? 1 : 0;
    my $censor = defined $opt{'censor-nsfw'} ? ($opt{'censor-nsfw'} ? 1 : 0) : 1;
    if ($nsfw) {
        $censor = 0;
    }
    $request->{nsfw} = $nsfw;
    $request->{censor_nsfw} = $censor;
}
if (defined $opt{format}) {
    my $of = $opt{format} eq 'jpg' ? 'jpeg' : $opt{format};
    $request->{output_format} = $of;
}

my $image = tubular::Image->new(
    base_url       => $base_url,
    horde_base_url => $horde_base_url,
    timeout        => $timeout,
);
my $res = $image->generate(%$request);

if (!$res->{ok}) {
    if ($opt{json}) {
        my %err = (
            ok    => 0,
            bin   => 'image',
            error => $res->{error},
        );
        $err{error_code}    = $res->{error_code}    if defined $res->{error_code};
        $err{error_type}    = $res->{error_type}    if defined $res->{error_type};
        $err{queued}        = $res->{queued}        if defined $res->{queued};
        $err{wait_time}     = $res->{wait_time}     if defined $res->{wait_time};
        $err{queue_position} = $res->{queue_position} if defined $res->{queue_position};
        $err{censored}      = $res->{censored}        if defined $res->{censored};
        print JSON::PP->new->utf8->canonical->pretty->encode(\%err);
    }
    else {
        warn "bin/image: $res->{error}\n";
    }
    exit 1;
}

# --- output naming ---
my $ext_override;
my $base;
if (defined $opt{output}) {
    my ($b, $dir, $e) = fileparse($opt{output}, qr/\.[^.\/]*\z/);
    $base = $dir . $b;
    if (defined $opt{format}) {
        $ext_override = lc $opt{format};
    }
    elsif (length $e) {
        $ext_override = $e =~ s/^\.//r;
    }
    else {
        $ext_override = 'png';
    }
}
if (!defined $base) {
    $base = 'image-' . Time::Piece->new->strftime('%Y%m%d-%H%M%S');
    $ext_override = lc $opt{format} if defined $opt{format};
}

my @names;
for my $idx (0 .. $#{$res->{images}}) {
    my $suffix = ($res->{requested_n} > 1) ? sprintf('-%03d', $idx + 1) : '';
    my $ext = defined $ext_override ? $ext_override : $res->{images}[$idx]{ext};
    push @names, $base . $suffix . '.' . $ext;
}

if (!$opt{force}) {
    for my $name (@names) {
        if (-e $name) {
            warn "bin/image: output exists (use --force to overwrite): $name\n";
            exit 1;
        }
    }
}

sub write_bytes ($path, $bytes) {
    my $tmp = "$path.tmp.$$";
    eval {
        open my $fh, '>:raw', $tmp or die "cannot write $tmp: $!";
        print {$fh} $bytes or die "cannot write $tmp: $!";
        close $fh or die "cannot close $tmp: $!";
        rename $tmp, $path or die "cannot rename $tmp -> $path: $!";
    };
    if ($@) {
        unlink $tmp if -e $tmp;
        return $@;
    }
    return undef;
}

for my $idx (0 .. $#{$res->{images}}) {
    my $werr = write_bytes($names[$idx], ${ $res->{images}[$idx]{bytes} });
    if (defined $werr) {
        warn "bin/image: $werr";
        exit 1;
    }
}

if ($opt{json}) {
    my $out = {
        ok          => 1,
        bin         => 'image',
        model       => $res->{model},
        prompt      => $prompt,
        base_url    => $res->{base_url},
        requested_n => $res->{requested_n},
        images      => [
            map {
                my $idx = $_;
                {
                    index => $idx,
                    file  => $names[$idx],
                    bytes => length ${ $res->{images}[$idx]{bytes} },
                    ext   => $res->{images}[$idx]{ext},
                    source => $res->{images}[$idx]{kind},
                    url   => $res->{images}[$idx]{url},
                }
            } 0 .. $#{$res->{images}}
        ],
    };
    $out->{wait_time} = $res->{wait_time} if defined $res->{wait_time};
    $out->{queue_position} = $res->{queue_position} if defined $res->{queue_position};
    print JSON::PP->new->utf8->canonical->pretty->encode($out);
}
elsif (@names == 1) {
    print "Generated image:\n";
    print "  Model:  $res->{model}\n";
    print "  Queue:  position $res->{queue_position}\n"
        if defined $res->{queue_position};
    print "  Wait:   ~$res->{wait_time} seconds estimated\n"
        if defined $res->{wait_time};
    print "  File:   $names[0]\n";
    print "  Size:   $size\n" if defined $size;
}
else {
    print 'Generated ' . scalar(@names) . " images:\n";
    print "  $_\n" for @names;
    print "  Model:  $res->{model}\n";
    print "  Queue:  position $res->{queue_position}\n"
        if defined $res->{queue_position};
    print "  Wait:   ~$res->{wait_time} seconds estimated\n"
        if defined $res->{wait_time};
}

if ($res->{requested_n} > @names) {
    warn 'bin/image: warning: requested ' . $res->{requested_n}
        . ' images but the API returned ' . scalar(@names) . "\n";
}

exit 0;
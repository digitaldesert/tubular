#!/usr/bin/env perl
use v5.44;
use warnings;

use FindBin qw($RealBin);
use lib "$RealBin/../lib";
use tubular::Config ();
use tubular::Extract ();
use tubular::Sequence ();
use tubular::Forecast ();
use JSON::PP ();

sub usage {
    return <<'USAGE';
tubular forecast - deterministic forecast for a sequence

Usage:
  bin/forecast FILE [options]
  bin/forecast --values "1 2 3" [options]

Options:
  --values STRING   parse numbers from STRING instead of a file
  --mode M          auto|numeric|categorical (default from config)
  --horizon N       number of future steps to forecast (default from config)
  --top K           max candidate values printed per step (default from config)
  --ensemble        combine methods weighted by rolling backtest error
  --window N        backtest training window for --ensemble (default 100)
  --min-train N     backtest minimum training length for --ensemble (default 10)
  --column C        CSV: header name or 0-based column index
  --pages RANGE     PDF: pages to read, e.g. 1-3,5
  --strict 0|1      fail on malformed input (default from config)
  --csv-header A    header policy: auto|always|never (default from config)
  --json            emit machine-readable JSON
  -h, --help        show this help and exit

All estimates are empirical (observed count ratios). The forecast never
invents values: candidates are values that actually occur in the input.
USAGE
}

sub usage_bad {
    my $msg = shift;
    warn "bin/forecast: $msg\n\n";
    warn usage();
    exit 2;
}

my %opt = (help => 0, json => 0, ensemble => 0);
my @files;
my $i = 0;
while ($i < @ARGV) {
    my $arg = $ARGV[$i++];
    if ($arg eq '-h' || $arg eq '--help') { $opt{help} = 1 }
    elsif ($arg eq '--json') { $opt{json} = 1 }
    elsif ($arg eq '--ensemble') { $opt{ensemble} = 1 }
    elsif ($arg eq '--values') {
        defined $ARGV[$i] or usage_bad("--values needs a value");
        $opt{values} = $ARGV[$i++];
    }
    elsif ($arg eq '--horizon' || $arg eq '--top') {
        defined $ARGV[$i] or usage_bad("$arg needs a value");
        my $v = $ARGV[$i++];
        usage_bad("$arg must be a positive integer") unless $v =~ /^\d+$/ && $v > 0;
        $opt{$arg =~ s/^--//r} = $v;
    }
    elsif ($arg eq '--window' || $arg eq '--min-train') {
        defined $ARGV[$i] or usage_bad("$arg needs a value");
        my $v = $ARGV[$i++];
        usage_bad("$arg must be a non-negative integer") unless $v =~ /^\d+$/;
        $opt{$arg =~ s/^--//r} = $v;
    }
    elsif ($arg eq '--mode' || $arg eq '--column' || $arg eq '--pages' || $arg eq '--strict' || $arg eq '--csv-header') {
        defined $ARGV[$i] or usage_bad("$arg needs a value");
        $opt{$arg =~ s/^--//r} = $ARGV[$i++];
    }
    elsif ($arg =~ /^-/) { usage_bad("unknown option '$arg'") }
    else { push @files, $arg }
}

if ($opt{help}) {
    print usage();
    exit 0;
}

if (defined $opt{values} && @files) {
    usage_bad("give FILE or --values, not both");
}
usage_bad("FILE or --values is required") unless defined $opt{values} || @files == 1;

if (defined $opt{mode}) {
    usage_bad("--mode must be auto, numeric or categorical")
        unless grep { $_ eq $opt{mode} } qw(auto numeric categorical);
}
if ($opt{ensemble} && defined $opt{mode}) {
    usage_bad("--ensemble cannot be combined with --mode");
}
if (!$opt{ensemble} && (defined $opt{window} || defined $opt{'min-train'})) {
    usage_bad("--window and --min-train only apply with --ensemble");
}
if ($opt{ensemble} && defined $opt{'min-train'} && $opt{'min-train'} == 0) {
    usage_bad("--min-train must be >= 1");
}

my $config = tubular::Config->new();
my $cfg = $config->as_hash();
$opt{mode}    = $cfg->{forecast}{mode}    unless defined $opt{mode};
$opt{horizon} = $cfg->{forecast}{horizon} unless defined $opt{horizon};
$opt{top}     = $cfg->{forecast}{top}     unless defined $opt{top};
$opt{strict}      = $cfg->{input}{strict}     unless defined $opt{strict};
$opt{csv_header}  = $cfg->{input}{csv_header} unless defined $opt{csv_header};

my $values;
my $source;
if (defined $opt{values}) {
    my $seq = tubular::Sequence->from_string($opt{values}, strict => $opt{strict});
    $values = [ $seq->values ];
    $source = 'values';
}
else {
    my %xopt = map { $_ => $opt{$_} } grep { defined $opt{$_} } qw(column pages strict csv_header);
    my $res = tubular::Extract->extract($files[0], mode => 'numbers', %xopt);
    if (!$res->{ok}) {
        warn "bin/forecast: $res->{error}\n";
        exit 1;
    }
    warn "bin/forecast: warning: $_\n" for @{ $res->{warnings} };
    $values = $res->{values};
    $source = $files[0];
}

my $f;
if ($opt{ensemble}) {
    $f = tubular::Forecast->ensemble(
        values        => $values,
        horizon       => $opt{horizon},
        top           => $opt{top},
        window        => defined $opt{window} ? $opt{window} : 100,
        min_train     => defined $opt{'min-train'} ? $opt{'min-train'} : 10,
        max_positions => $cfg->{forecast}{backtest_windows},
    );
}
else {
    $f = tubular::Forecast->forecast(
        values  => $values,
        mode    => $opt{mode},
        horizon => $opt{horizon},
        top     => $opt{top},
    );
}
if (!$f->{ok}) {
    warn "bin/forecast: $f->{error}\n";
    exit 1;
}

$f->{source} = $source;

if ($opt{json}) {
    print JSON::PP->new->utf8->canonical->pretty->encode($f);
    exit 0;
}

sub pct { sprintf '%.4f', $_[0] }
sub num {
    my $v = shift;
    return $v == int($v) ? "$v" : sprintf('%.6g', $v);
}
sub ordinal {
    my $n = shift;
    return "$n" . ($n % 10 == 1 && $n % 100 != 11 ? 'st'
        : ($n % 10 == 2 && $n % 100 != 12 ? 'nd'
        : ($n % 10 == 3 && $n % 100 != 13 ? 'rd' : 'th')));
}

printf "source:  %s\n", $source;
printf "values:  %d   unique:  %d\n", $f->{n}, $f->{unique};
printf "mode:    %s\n", $f->{mode};
printf "horizon: %d\n", $f->{horizon};

my $ctx = $f->{context};
if (defined $ctx->{value}) {
    print "\ncontext (conditioning on last observed value):\n";
    printf "  value %s at position %d\n", $ctx->{value}, $ctx->{position};
}
else {
    print "\ncontext: no single-value conditioning (numeric mode)\n";
}
print "  note: $ctx->{note}\n" if defined $ctx->{note};

for my $step (@{ $f->{steps} }) {
    printf "\nstep %d  (method: %s, %s)\n", $step->{step}, $step->{method}, $step->{label};
    if (@{ $step->{estimates} }) {
        printf "  %-4s %-10s %8s\n", 'rank', 'value', 'p';
        my $rank = 0;
        for my $e (@{ $step->{estimates} }) {
            $rank++;
            printf "  %-4s %-10s %8s\n", ordinal($rank), num($e->{value}), pct($e->{p});
        }
    }
    else {
        print "  (no data-derived estimates)\n";
    }
}

print "\nmethods used: ", join(', ', @{ $f->{methods} }), "\n";

if ($f->{mode} eq 'ensemble') {
    print "weighting:  $f->{weight_source}\n";
    my $k = 0;
    for my $m (sort keys %{ $f->{weights} }) {
        printf "  %-10s %s\n", $m, pct($f->{weights}{$m});
        $k++;
    }
    print "  (fallback: $f->{fallback})\n" if defined $f->{fallback};
}

exit 0;